{
  "name": "@baconbao/dsh-mermaid-image-preview",
  "description": "A DeepSeek Harness Plugin for Previewing Mermaid Diagram by Images in Chat Sessions. View on GitHub (https://github.com/baconbao/dsh-mermaid-image-preview).",
  "version": "0.4.0",
  "license": "MIT",
  "author": {
    "name": "baconbao",
    "url": "https://baconbao.org"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.6-alpha.2",
    "react": "^18.2.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "mermaid": "^11.16.1",
    "svgdom": "^0.1.28"
  }
}
